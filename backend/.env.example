# Redis carries both the RQ queue and the shared session/job state.
REDIS_URL=redis://localhost:6379/0

# Where photos, extracted characters, style assets and rendered pages live.
DATA_DIR=./data

# Comma-separated origins allowed to call this API from a browser. Left
# unset it allows the usual localhost dev origins and nothing else, which is
# all the ordinary deployment needs -- the app serves the PWA from its own
# origin. Set it to the real front-end origin when they are not the same.
# `*` still works, but with no authentication anywhere it means any page the
# user visits can read their session given only the session id.
# CORS_ORIGINS=https://codea4.example

# Werkzeug's interactive debugger offers a Python console on any traceback.
# Never set this on anything reachable.
# FLASK_DEBUG=1

# How long a session's data survives. Handwriting samples are personal and
# there is no account system, so state is deliberately temporary.
# STATE_TTL_SECONDS governs the records in Redis; DATA_RETENTION_SECONDS
# governs the files on disk -- the photographs, the extracted characters, the
# style model and the rendered pages. The second is never shorter than the
# first, so nothing is deleted out from under a session that still works.
STATE_TTL_SECONDS=604800
DATA_RETENTION_SECONDS=604800

# --- Development shortcuts -------------------------------------------------
# Run jobs inline in the web process and keep state in memory, so the whole
# flow works without Redis or a worker. Requests block for the length of the
# pipeline; never enable in production.
# INLINE_JOBS=1
# MEMORY_STATE=1

# --- Web push (optional) ---------------------------------------------------
# Without these the app runs normally and simply sends no notifications.
# Generate a key pair with:
#   python -c "from py_vapid import Vapid01; v = Vapid01(); v.generate_keys(); \
#     print(v.public_key_urlsafe_base64()); print(v.private_key_urlsafe_base64())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
